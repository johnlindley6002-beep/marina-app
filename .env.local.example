# Copy to .env.local and fill in from Supabase: Project Settings, API Keys.
# Both values are public by design. Never put the secret key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Set to "mock" to run the staff back office on the browser mock
# data instead of Supabase (the end-to-end tests do this).
# NEXT_PUBLIC_STAFF_DATA=mock

# Optional. Set to "mock" to run guest and berth holder accounts on the browser
# mock (sign in with the dev switcher) instead of Supabase. Without a Supabase
# project configured above, the mock is used automatically.
# NEXT_PUBLIC_ACCOUNT_DATA=mock
